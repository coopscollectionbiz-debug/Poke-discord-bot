# ==========================================================
# Coop's Collection Bot - Safe .gitignore for Render
# ==========================================================

# Node dependencies
node_modules/
.env

# Logs, cache, temp files
*.log
.cache/
tmp/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local training data / backups
trainerData.json
trainerData_backup*.json
trainerData.backup.*.json
# Durable local snapshots (persistence/localStore.js)
trainerData.json.tmp
trainerData.meta.json
trainerData.meta.json.tmp
trainerData.prev.json
trainerData.prev.meta.json
snapshots/
*.zip

# Append-only event log (per-instance local state)
*.ndjson
*.ndjson.tmp

# keep sprites folder in deploys
!public/sprites/
!public/sprites/**
!public/

# Optional: ignore large raw assets not used at runtime
raw_assets/

# Player-data backups (D-24). Never commit these; keep recovery copies outside the repo.
oldTrainerBackup.json
*Backup*.json
backup_*.json
*.backup.json
*.bundle

# Live events schedule (TRAINERDATA_DIR; default is the repo root)
live-events.json
